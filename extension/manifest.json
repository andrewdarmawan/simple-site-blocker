{
  "manifest_version": 3,
  "name": "Simple Site Blocker",
  "version": "1.0.0",
  "description": "Blocks the sites you choose, always or on a schedule. It can't read pages or see what you browse.",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Simple Site Blocker",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simple-site-blocker@andrewdarmawan",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
